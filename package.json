{
	"name": "headlesscode",
	"version": "1.8.1",
	"description": "Coding-agent harness with CLI and HTTP interfaces, parallel Git worktree orchestration, and bounded recursive self-improvement (RSI).",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Capsize-Games/headlesscode.git"
	},
	"author": "The headlesscode contributors",
	"keywords": [
		"cli",
		"coding-agent",
		"headless",
		"automation",
		"agent",
		"rsi",
		"recursive-self-improvement",
		"mcp",
		"agent-skills"
	],
	"type": "module",
	"engines": {
		"node": ">=22.19"
	},
	"bin": {
		"headlesscode": "bin/headlesscode.mjs",
		"headlesscode-control": "bin/headlesscode-control.mjs"
	},
	"files": [
		"LICENSE",
		"README.md",
		"ATTRIBUTION.md",
		"licenses/Apache-2.0.txt",
		"SECURITY.md",
		"CONTRIBUTING.md",
		"CODE_OF_CONDUCT.md",
		"docs/security-profiles.md",
		"docs/evidence-journal.md",
		"docs/emergency-control.md",
		"docs/hidden-verification.md",
		"docs/security-verification.md",
		"docs/incident-response.md",
		"docs/skills.md",
		"docs/extensions.md",
		"docs/sessions.md",
		"docs/terminal-chat.md",
		"tsconfig.json",
		"shared/",
		"src/",
		"!src/**/__tests__/",
		"!src/**/*.test.ts",
		"scripts/spawn-parallel-worktrees.sh",
		"scripts/run-worker.sh",
		"scripts/supervise-job-worker.mjs",
		"scripts/run-muse-worker.sh",
		"scripts/stop-worker.sh",
		"scripts/headlesscode-answer.sh",
		"scripts/deploy-gate.sh",
		"docs/muse-cache-qualification.md",
		"docs/work-loop.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"smoke": "tsx src/vendor/tests/smoke.ts",
		"dev": "tsx src/index.ts",
		"start": "tsx src/cli.ts",
		"cli": "tsx src/cli.ts",
		"monitor:pilot": "tsx scripts/monitor-pilot/run.ts",
		"rsi:promote-curriculum": "tsx src/rsi/promote-curriculum.ts",
		"rsi:security-canary": "tsx scripts/rsi-security-canary.ts",
		"rsi:proof-demonstration": "tsx scripts/rsi-proof-demonstration.ts",
		"test": "node scripts/run-tests.mjs",
		"prepublishOnly": "npm ci && npm test"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1142.0",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@octokit/auth-app": "^8.2.0",
		"fastest-levenshtein": "^1.0.16",
		"p-wait-for": "^5.0.2",
		"pg": "^8.23.0",
		"playwright": "^1.62.1",
		"simple-git": "^4.0.2",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"undici": "^8.10.0",
		"yaml": "^2.5.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@types/pg": "^8.23.1"
	}
}
