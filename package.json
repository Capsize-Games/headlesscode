{
	"name": "headlesscode",
	"version": "0.1.0",
	"private": true,
	"description": "Standalone headless coding-agent harness reusing Zoo Code's portable prompt/tool/mode core (Apache-2.0). Phase 1 engine.",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"bin": {
		"headlesscode": "src/cli.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"smoke": "tsx src/vendor/tests/smoke.ts",
		"dev": "tsx src/index.ts",
		"start": "tsx src/cli.ts",
		"cli": "tsx src/cli.ts",
		"test": "node scripts/run-tests.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@octokit/auth-app": "^8.2.0",
		"fastest-levenshtein": "^1.0.16",
		"p-wait-for": "^5.0.2",
		"pyright": "^1.1.411",
		"simple-git": "^3.36.0",
		"vscode-jsonrpc": "^9.0.1",
		"vscode-languageserver-protocol": "^3.18.2",
		"yaml": "^2.5.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"playwright": "^1.62.1",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0"
	}
}
